<Window x:Class="XhsXuanpin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="小红书选品工作台" Width="1500" Height="920" MinWidth="1100" MinHeight="720"
        Background="White" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PhoneColumn" Width="34*" MinWidth="400" MaxWidth="680"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="66*" MinWidth="560"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" x:Name="PhonePane" Background="#F7F7F7">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="12,0">
                <TextBlock Text="小红书" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="AndroidStatus" Text="Android · 正在连接" Foreground="#595959" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="1" x:Name="PhoneViewport" Margin="8,0,8,8" Background="White" ClipToBounds="True">
                <wfi:WindowsFormsHost x:Name="PhoneHost" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
            </Grid>
            <Grid Grid.Row="2" Background="White">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="14,9,8,8" VerticalAlignment="Center">
                    <TextBlock x:Name="BridgeTitle" Text="请在小红书中打开商品详情" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BridgeStatus" Text="进入商品详情后可一键采集" Foreground="#595959" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="MonitorButton" Content="加入监控" Height="36" Margin="0,0,8,0" Padding="14,0" VerticalAlignment="Center" Visibility="Collapsed" Click="MonitorButton_Click"/>
                <Button Grid.Column="2" x:Name="SelectionButton" Content="加入选品中心" Height="36" Margin="0,0,14,0" Padding="14,0" VerticalAlignment="Center" Visibility="Collapsed" IsEnabled="False" ToolTip="当前阶段不开发选品中心"/>
            </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" x:Name="PhoneSplitter"
                      Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#EFEFEF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" DragCompleted="PhoneSplitter_DragCompleted"/>
        <Button Grid.Column="1" x:Name="PhoneToggle" Click="PhoneToggle_Click" Panel.ZIndex="1"
                Width="20" Height="64" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#DDDDDD" BorderThickness="1" Background="White" Foreground="#595959"
                FontSize="16" ToolTip="收起手机预览">
            <TextBlock x:Name="PhoneToggleLabel" Text="‹" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Grid Grid.Column="2"><wv2:WebView2 x:Name="Workspace"/></Grid>
    </Grid>
</Window>
