<Window x:Class="XhsXuanpin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="小红书选品工作台" Width="1500" Height="920" MinWidth="1180" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize"
        Background="White" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F3F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProductActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F7F8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F7F7F8"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#B5BAC3"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhoneAppToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F7F7F7"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CFCFCF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlobalCollectionToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F7F7F7"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CFCFCF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlobalTabButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFAFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,6,6" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PhoneColumn" Width="34*" MinWidth="400" MaxWidth="680"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="66*" MinWidth="720"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="PhoneKeyboardSink"
                 Grid.Row="0" Grid.Column="0"
                 Width="1" Height="1" Opacity="0"
                 IsTabStop="False" IsHitTestVisible="False"
                 InputMethod.IsInputMethodEnabled="True"
                 PreviewTextInput="PhoneKeyboardSink_PreviewTextInput"
                 PreviewKeyDown="PhoneKeyboardSink_PreviewKeyDown"/>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="White" BorderBrush="#EDEDED" BorderThickness="0,0,0,1"/>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Margin="16,0,0,0">
            <Border Width="30" Height="30" CornerRadius="8" Background="#FF2442">
                <TextBlock Text="选" Foreground="White" FontWeight="SemiBold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="小红书选品工作台" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="人工选品 · V1" FontSize="12" Foreground="#595959" Margin="10,1,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="GlobalTabsHost" Grid.Row="0" Grid.Column="2"
                    Orientation="Horizontal" HorizontalAlignment="Left">
            <Grid Width="88" Height="58">
                <Button x:Name="SingleTabButton" Style="{StaticResource GlobalTabButtonStyle}"
                        Click="SingleTabButton_Click">
                    <TextBlock x:Name="SingleTabText" Text="单品监控" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                </Button>
                <Border x:Name="SingleTabIndicator" Height="2" Background="#FF2442"
                        VerticalAlignment="Bottom" Margin="15,0" IsHitTestVisible="False"/>
            </Grid>
            <Grid Width="88" Height="58">
                <Button x:Name="ShopsTabButton" Style="{StaticResource GlobalTabButtonStyle}"
                        Click="ShopsTabButton_Click">
                    <TextBlock x:Name="ShopsTabText" Text="店铺监控" FontSize="13" Foreground="#595959"/>
                </Button>
                <Border x:Name="ShopsTabIndicator" Height="2" Background="#FF2442"
                        VerticalAlignment="Bottom" Margin="15,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <Grid Width="88" Height="58">
                <Button x:Name="SelectionTabButton" Style="{StaticResource GlobalTabButtonStyle}"
                        Click="SelectionTabButton_Click">
                    <TextBlock x:Name="SelectionTabText" Text="选品中心" FontSize="13" Foreground="#595959"/>
                </Button>
                <Border x:Name="SelectionTabIndicator" Height="2" Background="#FF2442"
                        VerticalAlignment="Bottom" Margin="15,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Height="30" Padding="10,0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="GlobalServiceDot" Width="7" Height="7" Fill="#1FA663" Margin="0,0,6,0"/>
                    <TextBlock x:Name="GlobalServiceStatus" Text="采集服务正常" FontSize="12" Foreground="#595959"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Height="30" Margin="8,0,0,0" Padding="10,0"
                    BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="GlobalCollectionIntervalText" Text="全局采集 60 分钟" FontSize="12" Foreground="#595959"/>
                    <TextBlock x:Name="GlobalCollectionStateText" Text=" · 启动中" FontSize="11" Foreground="#E89A19"/>
                </StackPanel>
            </Border>
            <Button x:Name="GlobalCollectionToggleButton"
                    Style="{StaticResource GlobalCollectionToggleButtonStyle}"
                    Content="暂停采集"
                    Click="GlobalCollectionToggleButton_Click"
                    ToolTip="暂停全局自动采集；不影响手动立即采集"/>
            <TextBlock x:Name="CurrentTimeText" Text="--:--" FontSize="12" Foreground="#595959"
                       Margin="12,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                    Content="—" Click="MinimizeButton_Click" ToolTip="最小化"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}"
                    Content="□" Click="MaximizeButton_Click" ToolTip="最大化"/>
            <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButtonStyle}"
                    Content="×" Click="CloseButton_Click" ToolTip="关闭"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" x:Name="PhonePane" Background="#F7F7F7">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="XhsAppToggleButton"
                        Style="{StaticResource PhoneAppToggleButtonStyle}"
                        Content="检测中…"
                        Margin="0"
                        IsEnabled="False"
                        Click="XhsAppToggleButton_Click"
                        ToolTip="关闭小红书 App 和手机画面流；MuMu、ADB 和后台采集保持运行"/>
                <TextBlock Grid.Column="2" x:Name="AndroidStatus" Text="Android · 正在连接" Foreground="#595959" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="1" x:Name="PhoneViewport" Margin="8,0,8,8" Background="White" ClipToBounds="True">
                <wfi:WindowsFormsHost x:Name="PhoneHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Hidden"
                                      SnapsToDevicePixels="True"/>
                <Border x:Name="XhsLaunchPlaceholder"
                        Background="White"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="5">
                    <Image Source="Assets/xhs-launch-placeholder.jpg"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           SnapsToDevicePixels="True"/>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#EDEDED" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,8,10,8" VerticalAlignment="Center">
                        <TextBlock x:Name="BridgeTitle" Text="请在小红书中打开商品详情" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BridgeStatus" Text="进入商品详情后可一键采集" Foreground="#595959"
                                   FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="MonitorButton" Content="加入监控" Height="34"
                            Margin="0,0,8,0" Padding="14,0" VerticalAlignment="Center"
                            Style="{StaticResource ProductActionButtonStyle}"
                            IsEnabled="False" Click="MonitorButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Grid.Column="2" x:Name="SelectionButton" Content="加入选品中心" Height="34"
                            Margin="0,0,14,0" Padding="14,0" VerticalAlignment="Center"
                            Style="{StaticResource ProductActionButtonStyle}"
                            IsEnabled="False" Click="SelectionButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" x:Name="PhoneSplitter"
                      Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#EFEFEF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" DragCompleted="PhoneSplitter_DragCompleted"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

        <Button Grid.Row="1" Grid.Column="1" x:Name="PhoneToggle"
                Click="PhoneToggle_Click" Panel.ZIndex="1"
                Width="20" Height="64" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#DDDDDD" BorderThickness="1" Background="White" Foreground="#595959"
                FontSize="16" ToolTip="收起手机预览"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="PhoneToggleLabel" Text="‹"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Grid Grid.Row="1" Grid.Column="2">
            <wv2:WebView2 x:Name="Workspace"/>
        </Grid>
    </Grid>
</Window>
